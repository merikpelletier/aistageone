{
  "name": "ChatMessageComment",
  "type": "object",
  "properties": {
    "salon": {
      "type": "string",
      "enum": [
        "cochon",
        "contact",
        "commercial"
      ],
      "description": "Chat room containing the post"
    },
    "message_id": {
      "type": "string",
      "description": "ID of the ChatMessage being commented on"
    },
    "author_identifier": {
      "type": "string",
      "description": "Chat identifier of the comment author"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier for cleanup"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    }
  },
  "required": [
    "salon",
    "message_id",
    "author_identifier",
    "session_id",
    "content"
  ]
}