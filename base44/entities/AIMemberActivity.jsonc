{
  "name": "AIMemberActivity",
  "type": "object",
  "properties": {
    "ai_member_id": { "type": "string" },
    "activity_type": {
      "type": "string",
      "enum": ["publish", "comment", "like", "follow", "sponsor", "sell", "collaborate", "system"]
    },
    "target_type": { "type": "string", "description": "dossier, member, product, asset, sponsor, post, etc." },
    "target_id": { "type": "string" },
    "target_label": { "type": "string" },
    "content": { "type": "string", "description": "Generated or admin-authored activity text" },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "published", "cancelled"],
      "default": "draft"
    },
    "scheduled_for": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "required": ["ai_member_id", "activity_type", "status"]
}