{
  "name": "SimLocation",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the StorySession this simulation belongs to"
    },
    "simulation_run_id": {
      "type": "string",
      "description": "Optional identifier for a specific simulation run within the session"
    },
    "name": {
      "type": "string",
      "description": "Location name"
    },
    "description": {
      "type": "string",
      "description": "Atmosphere / physical layout"
    },
    "parent_location_id": {
      "type": "string",
      "description": "Optional \u2014 parent SimLocation for nested locations (e.g. shop inside market)"
    },
    "source_story_set_id": {
      "type": "string",
      "description": "Back-link to the StorySet this SimLocation was initialized from."
    },
    "sim_location_type": {
      "type": "string",
      "description": "Copied verbatim from StorySet at initialization. Never derived."
    },
    "sim_public_access": {
      "type": "string",
      "enum": [
        "open",
        "controlled",
        "restricted",
        "private"
      ],
      "description": "Copied verbatim from StorySet; may be overridden by a matching time profile."
    },
    "sim_crowd_level": {
      "type": "string",
      "enum": [
        "empty",
        "low",
        "moderate",
        "high",
        "packed"
      ],
      "description": "Effective crowd density (base overridden by current time profile)."
    },
    "sim_visibility": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "description": "Effective visibility (base overridden by current time profile)."
    },
    "sim_privacy": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high",
        "complete"
      ],
      "description": "Effective privacy (base overridden by current time profile)."
    },
    "sim_guard_presence": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high"
      ],
      "description": "Effective guard presence (base overridden by current time profile)."
    },
    "sim_general_danger": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "extreme"
      ],
      "description": "Effective danger (base overridden by current time profile)."
    },
    "sim_ambush_risk": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "extreme"
      ],
      "description": "Effective ambush risk (base overridden by current time profile)."
    },
    "sim_surveillance_risk": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "extreme"
      ],
      "description": "Effective surveillance risk (base overridden by current time profile)."
    },
    "sim_escape_difficulty": {
      "type": "string",
      "enum": [
        "very_easy",
        "easy",
        "moderate",
        "difficult",
        "very_difficult"
      ],
      "description": "Copied verbatim from StorySet."
    },
    "sim_entry_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_exit_routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_hiding_places": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_environmental_hazards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_suitable_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_unsuitable_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copied verbatim from StorySet."
    },
    "sim_special_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Effective special rules (base overridden by current time profile)."
    },
    "sim_time_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_period": {
            "type": "string",
            "enum": [
              "dawn",
              "morning",
              "afternoon",
              "evening",
              "night",
              "late_night"
            ]
          },
          "crowd_level": {
            "type": "string",
            "enum": [
              "empty",
              "low",
              "moderate",
              "high",
              "packed"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "very_low",
              "low",
              "moderate",
              "high",
              "very_high"
            ]
          },
          "privacy": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "moderate",
              "high",
              "complete"
            ]
          },
          "guard_presence": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "moderate",
              "high"
            ]
          },
          "general_danger": {
            "type": "string",
            "enum": [
              "very_low",
              "low",
              "moderate",
              "high",
              "extreme"
            ]
          },
          "ambush_risk": {
            "type": "string",
            "enum": [
              "very_low",
              "low",
              "moderate",
              "high",
              "extreme"
            ]
          },
          "surveillance_risk": {
            "type": "string",
            "enum": [
              "very_low",
              "low",
              "moderate",
              "high",
              "extreme"
            ]
          },
          "special_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "time_period"
        ]
      },
      "description": "Copied verbatim from StorySet. Retained so future SimWorldTime changes can re-apply a different profile."
    }
  },
  "required": [
    "session_id",
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}