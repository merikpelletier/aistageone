{
  "name": "DossierPage",
  "type": "object",
  "properties": {
    "dossier_id": {
      "type": "string",
      "description": "Reference to parent dossier"
    },
    "page_type": {
      "type": "string",
      "enum": [
        "cover",
        "text",
        "image",
        "video",
        "mixed",
        "join_cast",
        "episode",
        "series",
        "production_kit",
        "member_episodes",
        "block_player",
        "index",
        "contest",
        "credits"
      ],
      "description": "Type of content block"
    },
    "title": {
      "type": "string",
      "description": "Optional page title"
    },
    "content": {
      "type": "string",
      "description": "Text content (for text or mixed pages)"
    },
    "media_url": {
      "type": "string",
      "description": "URL of image or video (portrait)"
    },
    "media_url_landscape": {
      "type": "string",
      "description": "URL of image or video for landscape orientation (optional, falls back to media_url)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery images for products or sets (max 12)"
    },
    "order": {
      "type": "number",
      "description": "Page order within dossier"
    },
    "image_layout": {
      "type": "string",
      "enum": [
        "background",
        "above",
        "below"
      ],
      "default": "background",
      "description": "How the image is displayed on mixed pages"
    },
    "text_position": {
      "type": "string",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "default": "center"
    },
    "text_color": {
      "type": "string",
      "enum": [
        "white",
        "black"
      ],
      "default": "white"
    },
    "is_product": {
      "type": "boolean",
      "default": false,
      "description": "If true, this page is a product"
    },
    "price": {
      "type": "string",
      "description": "Display price for products"
    },
    "product_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "episode_title": {
      "type": "string",
      "description": "Episode title (for episode pages)"
    },
    "episode_description": {
      "type": "string",
      "description": "Episode brief/description (for episode pages)"
    },
    "episode_role": {
      "type": "string",
      "description": "Role or character available (for episode pages)"
    },
    "episode_tools_hint": {
      "type": "string",
      "description": "Suggested AI tools (for episode pages)"
    },
    "cast_episodes": {
      "type": "array",
      "description": "List of episodes members can join (for join_cast page type)",
      "items": {
        "type": "object",
        "properties": {
          "episode_title": {
            "type": "string"
          },
          "episode_description": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tools_hint": {
            "type": "string"
          }
        }
      }
    },
    "cast_members_only": {
      "type": "boolean",
      "default": true
    },
    "series_presentation": {
      "type": "string",
      "description": "Series overview / pitch text (for series pages)"
    },
    "series_characters": {
      "type": "array",
      "description": "Character profiles for the series",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "character_type": {
            "type": "string",
            "description": "Archetype/role of the character (e.g. Hero, Villain, Mentor)"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Gallery of reference photos for the character"
          }
        }
      }
    },
    "series_sets": {
      "type": "array",
      "description": "Set locations for the series (source of truth, synced to kit pages)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "series_costumes": {
      "type": "array",
      "description": "Costume references for the series",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kit_description": {
      "type": "string",
      "description": "Production kit overview / description"
    },
    "kit_sets": {
      "type": "array",
      "description": "Set locations with media galleries",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kit_characters": {
      "type": "array",
      "description": "Characters with reference media galleries",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "character_type": {
            "type": "string",
            "description": "Archetype/role of the character (e.g. Hero, Villain, Mentor)"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kit_costumes": {
      "type": "array",
      "description": "Costume references with media galleries",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kit_reference_media": {
      "type": "array",
      "description": "General reference media (images/videos)",
      "items": {
        "type": "string"
      }
    },
    "block_player_episode_page_id": {
      "type": "string",
      "description": "ID of the StorySession to load blocks from (for block_player page type)"
    },
    "block_player_block_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific StoryBlock IDs to play (for block_player pages). Empty = play all chapters in the session."
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether this episode is locked by admin (prevents members from creating scenes)"
    },
    "is_hidden_from_public": {
      "type": "boolean",
      "default": false,
      "description": "Hide this page from public dossier view (still accessible in Studio)"
    },
    "show_studio_banner": {
      "type": "boolean",
      "default": false,
      "description": "Show banner 'AVAILABLE IN THE STUDIO ON THE STAGE SECTION' (for series pages)"
    },
    "contest_category": {
      "type": "string",
      "description": "Contest/open-call category, such as Next Face, Designer, or Actor"
    },
    "contest_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Optional deadline for contest submissions"
    },
    "contest_reward": {
      "type": "string",
      "description": "Prize, opportunity, role, or other reward"
    },
    "contest_rules": {
      "type": "string",
      "description": "Contest eligibility and entry rules"
    },
    "contest_submission_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text",
          "link",
          "media"
        ]
      },
      "description": "Accepted submission content types"
    },
    "contest_status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed"
      ],
      "default": "open"
    },
    "contest_cta_label": {
      "type": "string",
      "description": "Public submit button label"
    },
    "hide_title": {
      "type": "boolean",
      "default": false,
      "description": "Keep the page title in admin/navigation but hide it in the public page layout"
    },
    "contest_media_style": {
      "type": "string",
      "enum": [
        "hero",
        "background",
        "none"
      ],
      "default": "hero",
      "description": "How contest media is presented"
    },
    "contest_overlay_opacity": {
      "type": "number",
      "description": "Dark overlay opacity percentage for contest media"
    },
    "contest_accent_color": {
      "type": "string",
      "description": "Accent color used by the contest call-to-action"
    },
    "credits_sections": {
      "type": "array",
      "description": "Structured credits sections. Each section can optionally have an image and contains role/name/note entries.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "image_url": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "name": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "dossier_id",
    "page_type",
    "order"
  ]
}
