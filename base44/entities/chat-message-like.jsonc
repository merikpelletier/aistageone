{
  "name": "ChatMessageLike",
  "type": "object",
  "properties": {
    "salon": {
      "type": "string",
      "enum": [
        "cochon",
        "contact",
        "commercial"
      ],
      "description": "Chat room containing the post"
    },
    "message_id": {
      "type": "string",
      "description": "ID of the ChatMessage being liked"
    },
    "user_identifier": {
      "type": "string",
      "description": "Chat identifier of the user who liked the post"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier for cleanup"
    }
  },
  "required": [
    "salon",
    "message_id",
    "user_identifier",
    "session_id"
  ]
}