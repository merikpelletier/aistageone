{
  "name": "SimInformationTransmission",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the StorySession this simulation belongs to"
    },
    "simulation_run_id": {
      "type": "string",
      "description": "Optional identifier for a specific simulation run within the session"
    },
    "claim_id": {
      "type": "string",
      "description": "SimClaim being transmitted"
    },
    "sender_id": {
      "type": "string",
      "description": "SimCharacter communicating the claim"
    },
    "receiver_id": {
      "type": "string",
      "description": "SimCharacter receiving the claim"
    },
    "transmission_tick": {
      "type": "number",
      "description": "Tick when the transmission occurred"
    },
    "original_claim_text": {
      "type": "string",
      "description": "The claim text as the sender knew it"
    },
    "transmitted_claim_text": {
      "type": "string",
      "description": "The claim text as the receiver heard it (may differ if mutated)"
    },
    "mutation_type": {
      "type": "string",
      "enum": [
        "none",
        "exaggerated",
        "minimized",
        "distorted"
      ],
      "default": "none",
      "description": "How the claim changed during transmission"
    }
  },
  "required": [
    "session_id",
    "claim_id",
    "sender_id",
    "receiver_id"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}