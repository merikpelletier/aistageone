{
  "name": "SimActiveSituation",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the StorySession this simulation belongs to"
    },
    "simulation_run_id": {
      "type": "string",
      "description": "Optional identifier for a specific simulation run within the session"
    },
    "name": {
      "type": "string",
      "description": "Situation name (e.g. 'Debt Pressure on Aelia')"
    },
    "description": {
      "type": "string",
      "description": "What the situation is about"
    },
    "situation_type": {
      "type": "string",
      "enum": [
        "debt",
        "investigation",
        "threat",
        "deadline",
        "other"
      ],
      "description": "Category of the situation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "escalating",
        "resolved",
        "abandoned"
      ],
      "default": "active",
      "description": "Current status of the situation"
    },
    "affected_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SimCharacter IDs involved in this situation"
    },
    "escalation_stage": {
      "type": "number",
      "default": 0,
      "description": "Current escalation level (0 = baseline)"
    },
    "resolution_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "is_met": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Conditions that must ALL be true for the situation to resolve."
    },
    "created_tick": {
      "type": "number",
      "description": "Tick when the situation began"
    },
    "source_starting_topic_id": {
      "type": "string",
      "description": "Back-link to the StartingTopic this situation was initialized from."
    }
  },
  "required": [
    "session_id",
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}