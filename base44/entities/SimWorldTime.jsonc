{
  "name": "SimWorldTime",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the StorySession this simulation belongs to"
    },
    "simulation_run_id": {
      "type": "string",
      "description": "Optional identifier for a specific simulation run within the session"
    },
    "current_tick": {
      "type": "number",
      "default": 0,
      "description": "Integer tick counter \u2014 the simulation clock"
    },
    "current_time_label": {
      "type": "string",
      "description": "Human-readable label for the current time (e.g. 'Day 1, Late Morning')"
    },
    "tick_duration_label": {
      "type": "string",
      "description": "What one tick represents (e.g. '~1 hour')"
    }
  },
  "required": [
    "session_id"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}