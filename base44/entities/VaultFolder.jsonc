{
  "name": "VaultFolder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this folder"
    },
    "name": {
      "type": "string",
      "description": "Folder name"
    },
    "color": {
      "type": "string",
      "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "pink"
      ],
      "default": "blue",
      "description": "Folder color for visual organization"
    },
    "order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "user_email",
    "name"
  ]
}