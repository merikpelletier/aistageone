{
  "name": "AIMember",
  "type": "object",
  "properties": {
    "display_name": { "type": "string", "description": "Public display name of the virtual AI member" },
    "handle": { "type": "string", "description": "Unique public handle without @" },
    "avatar_url": { "type": "string", "description": "Profile avatar image URL" },
    "member_type": {
      "type": "string",
      "enum": ["creator", "talent", "media", "sponsor", "merchant", "producer", "social"],
      "default": "creator"
    },
    "headline": { "type": "string", "description": "Internal/legacy short public role" },
    "title": { "type": "string", "description": "Professional title or role, matching regular member profiles" },
    "bio": { "type": "string", "description": "Public biography" },
    "images": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Profile gallery image URLs (up to 6)"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        }
      },
      "description": "Public social/web links"
    },
    "custom_banner_url": { "type": "string", "description": "Custom profile banner image URL" },
    "custom_banner_link": { "type": "string", "description": "URL opened when the profile banner is clicked" },
    "language": { "type": "string", "default": "en" },
    "location_label": { "type": "string", "description": "Optional fictional or general location shown publicly" },
    "persona": { "type": "string", "description": "Internal persona and behavioral direction" },
    "voice_style": { "type": "string", "description": "Internal writing/tone guidance" },
    "visual_style": { "type": "string", "description": "Internal visual identity guidance" },
    "interests": { "type": "array", "items": { "type": "string" } },
    "content_types": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "properties": {
        "publish": { "type": "boolean", "default": false },
        "comment": { "type": "boolean", "default": false },
        "like": { "type": "boolean", "default": false },
        "follow": { "type": "boolean", "default": false },
        "sponsor": { "type": "boolean", "default": false },
        "sell": { "type": "boolean", "default": false },
        "collaborate": { "type": "boolean", "default": false }
      }
    },
    "automation_enabled": { "type": "boolean", "default": false },
    "activity_frequency": {
      "type": "string",
      "enum": ["manual", "low", "normal", "high"],
      "default": "manual"
    },
    "automation_config": {
      "type": "object",
      "description": "Per-member activity planner settings used by the automation system",
      "properties": {
        "daily_min": { "type": "integer", "default": 1 },
        "daily_max": { "type": "integer", "default": 3 },
        "active_days": { "type": "array", "items": { "type": "string" }, "default": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
        "active_start": { "type": "string", "default": "09:00" },
        "active_end": { "type": "string", "default": "21:00" },
        "use_interests": { "type": "boolean", "default": true },
        "activity_mix": {
          "type": "object",
          "properties": {
            "publish": { "type": "boolean", "default": true },
            "comment": { "type": "boolean", "default": true },
            "like": { "type": "boolean", "default": true },
            "follow": { "type": "boolean", "default": false },
            "sponsor": { "type": "boolean", "default": false },
            "sell": { "type": "boolean", "default": false },
            "collaborate": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "quiet_hours": { "type": "string", "description": "Optional internal quiet-hours note" },
    "is_active": { "type": "boolean", "default": true },
    "is_ai_disclosed": { "type": "boolean", "default": true, "description": "Must remain true so the account is clearly identified as virtual/AI" },
    "notes": { "type": "string", "description": "Internal admin notes" }
  },
  "required": ["display_name", "handle", "member_type", "is_ai_disclosed"]
}