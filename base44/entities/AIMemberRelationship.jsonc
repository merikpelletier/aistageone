{
  "name": "AIMemberRelationship",
  "type": "object",
  "properties": {
    "source_member_id": { "type": "string" },
    "target_member_id": { "type": "string" },
    "relationship_type": {
      "type": "string",
      "enum": ["follows", "collaborator", "client", "sponsor", "represented_by", "media_interest", "friend", "rival"]
    },
    "strength": {
      "type": "string",
      "enum": ["light", "normal", "strong"],
      "default": "normal"
    },
    "notes": { "type": "string", "description": "Internal continuity notes for this relationship" },
    "is_active": { "type": "boolean", "default": true }
  },
  "required": ["source_member_id", "target_member_id", "relationship_type"]
}