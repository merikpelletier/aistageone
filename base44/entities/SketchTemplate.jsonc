{
  "name": "SketchTemplate",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Display name of the Stage theme" },
    "output_type": {
      "type": "string",
      "enum": ["video", "image", "both"],
      "default": "both",
      "description": "Media offered by this Stage. 'both' lets the user choose Image or Video after choosing the theme/style."
    },
    "category": {
      "type": "string",
      "enum": ["experience", "comedy", "character_intro"],
      "default": "experience",
      "description": "Stage browsing category"
    },
    "description": { "type": "string", "description": "Short subtitle shown under the theme name" },
    "scenario": { "type": "string", "description": "The transformation or situation presented to the user." },
    "base_scene_prompt": { "type": "string", "description": "Optional prompt used to generate a base scene reference for video output." },
    "image_prompt": { "type": "string", "description": "Default image-generation prompt used when the selected style has no image prompt." },
    "video_prompt": { "type": "string", "description": "Default video-generation prompt used when the selected style has no video prompt." },
    "styles": {
      "type": "array",
      "default": [],
      "description": "Selectable variants inside a Stage. A style can define separate prompts for image and video output.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "preview_image": { "type": "string" },
          "prompt": { "type": "string", "description": "Legacy image prompt retained for backward compatibility." },
          "image_prompt": { "type": "string" },
          "video_prompt": { "type": "string" },
          "transformation_prompt": { "type": "string" }
        }
      }
    },
    "transformation_prompt": { "type": "string", "description": "Optional default end-state transformation prompt for video morph Stages." },
    "base_scene_image": { "type": "string", "description": "Optional admin-authored base scene photo used by video Stages." },
    "default_duration": { "type": "number", "default": 5, "description": "Default video duration in seconds (5 or 10)." },
    "default_aspect_ratio": {
      "type": "string",
      "enum": ["16:9", "9:16", "1:1"],
      "default": "9:16",
      "description": "Default aspect ratio for generated media"
    },
    "cover_image": { "type": "string", "description": "Optional cover/thumbnail image URL for the theme card" },
    "is_active": { "type": "boolean", "default": true, "description": "Whether the theme is shown in Stages" },
    "order": { "type": "number", "default": 0, "description": "Display order" }
  },
  "required": ["name", "category", "scenario"],
  "rls": {
    "read": true,
    "create": { "created_by": "{{user.email}}" },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}