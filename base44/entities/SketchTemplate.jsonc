{
  "name": "SketchTemplate",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Display name of the stage theme" },
    "output_type": {
      "type": "string",
      "enum": ["video", "image"],
      "default": "video",
      "description": "Final media generated by this Stage. Existing templates without this field are treated as video."
    },
    "category": {
      "type": "string",
      "enum": ["comedy", "character_intro"],
      "default": "comedy",
      "description": "Theme category shown in Stages"
    },
    "description": { "type": "string", "description": "Short subtitle shown under the theme name" },
    "scenario": { "type": "string", "description": "The situation or creative setup presented to the user." },
    "base_scene_prompt": { "type": "string", "description": "The exact text prompt used by AI to generate the base scene image for video stages." },
    "image_prompt": { "type": "string", "description": "Default image prompt used when no Stage style is selected." },
    "video_prompt": { "type": "string", "description": "Default video prompt used when no Stage style is selected." },
    "styles": {
      "type": "array",
      "default": [],
      "description": "Selectable creative styles for this Stage. Each style can provide its own preview image and generation prompt.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "preview_image": { "type": "string" },
          "prompt": { "type": "string" }
        }
      }
    },
    "transformation_prompt": { "type": "string", "description": "Optional end-state transformation prompt for video morph stages." },
    "base_scene_image": { "type": "string", "description": "Admin-authored base scene photo used by character-replacement video stages." },
    "default_duration": { "type": "number", "default": 5, "description": "Default video duration in seconds (5 or 10). Ignored by image Stages." },
    "default_aspect_ratio": {
      "type": "string",
      "enum": ["16:9", "9:16", "1:1"],
      "default": "9:16",
      "description": "Default aspect ratio for generated media"
    },
    "cover_image": { "type": "string", "description": "Optional cover/thumbnail image URL for the theme card" },
    "is_active": { "type": "boolean", "default": true, "description": "Whether the theme is shown in Stages" },
    "order": { "type": "number", "default": 0, "description": "Display order" }
  },
  "required": ["name", "category", "scenario"],
  "rls": {
    "read": true,
    "create": { "created_by": "{{user.email}}" },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}