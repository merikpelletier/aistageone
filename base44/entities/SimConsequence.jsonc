{
  "name": "SimConsequence",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the StorySession this simulation belongs to"
    },
    "simulation_run_id": {
      "type": "string",
      "description": "Optional identifier for a specific simulation run within the session"
    },
    "source_action_id": {
      "type": "string",
      "description": "SimCharacterAction that triggered this consequence"
    },
    "source_state_change_id": {
      "type": "string",
      "description": "Optional \u2014 specific SimStateChange that caused it"
    },
    "consequence_type": {
      "type": "string",
      "enum": [
        "situation_advance",
        "situation_regression",
        "situation_escalation",
        "danger_created",
        "uncertainty_reduced",
        "no_effect"
      ],
      "description": "Nature of the consequence. A successful action does NOT automatically resolve a situation \u2014 it only advances, regresses, escalates, or has no effect. Resolution requires all resolution_conditions to be met."
    },
    "affected_situation_id": {
      "type": "string",
      "description": "Optional \u2014 SimActiveSituation impacted"
    },
    "description": {
      "type": "string",
      "description": "What the consequence is"
    },
    "consequence_tick": {
      "type": "number",
      "description": "Tick when the consequence was applied"
    }
  },
  "required": [
    "session_id",
    "source_action_id",
    "consequence_type"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}